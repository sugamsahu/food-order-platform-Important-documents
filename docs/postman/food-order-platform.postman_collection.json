{
  "info": {
    "name": "Food Order Platform",
    "description": "Runnable demo of the mobile order flow and the staff workflow against local seed data (npm run db:reset). Run the requests in order, or use: newman run food-order-platform.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{serverUrl}}/health-check",
              "host": [
                "{{serverUrl}}"
              ],
              "path": [
                "health-check"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Mobile customer flow",
      "item": [
        {
          "name": "1. Customer login (seed customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns a token and the customer', () => { pm.expect(b.token).to.be.a('string'); pm.expect(b.customer.email).to.eql('customer@example.com'); });",
                  "pm.collectionVariables.set('customerToken', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mobile/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mobile",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. List published foods",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('only available foods, paginated', () => { pm.expect(b.data.length).to.be.above(0); b.data.forEach(f => pm.expect(f.is_available).to.be.true); pm.expect(b.pagination).to.have.keys('page','page_size','total','total_pages'); });",
                  "const pizza = b.data.find(f => f.name === 'Margherita Pizza');",
                  "pm.expect(pizza, 'seed food Margherita Pizza').to.exist;",
                  "pm.collectionVariables.set('foodId', pizza.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mobile/foods?page_size=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mobile",
                "foods"
              ],
              "query": [
                {
                  "key": "page_size",
                  "value": "50"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "3. Place an order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('order is Placed with a reference and server-calculated total', () => { pm.expect(b.status).to.eql('Placed'); pm.expect(b.reference).to.match(/^FO-\\d{6}$/); pm.expect(b.total).to.eql('96.00'); pm.expect(b.items[0].food_name).to.eql('Margherita Pizza'); });",
                  "pm.collectionVariables.set('orderId', b.id);",
                  "pm.collectionVariables.set('orderReference', b.reference);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mobile/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mobile",
                "orders"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"food_id\": \"{{foodId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"fulfillment_type\": \"delivery\",\n  \"delivery_address\": \"Villa 12, Al Wasl Road, Jumeirah, Dubai\",\n  \"notes\": \"Postman demo order\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4. Read my order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status history starts at Placed', () => { const h = pm.response.json().status_history; pm.expect(h[0].to_status).to.eql('Placed'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mobile/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mobile",
                "orders",
                "{{orderId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "5. List my orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('newest order first', () => pm.expect(pm.response.json().data[0].reference).to.eql(pm.collectionVariables.get('orderReference')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mobile/orders?page_size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mobile",
                "orders"
              ],
              "query": [
                {
                  "key": "page_size",
                  "value": "5"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Staff workflow",
      "item": [
        {
          "name": "6. Operator login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('operator role', () => pm.expect(b.user.role).to.eql('operator'));",
                  "pm.collectionVariables.set('staffToken', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/staff/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "staff",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7. Find the order by reference",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('exactly one match', () => { const b = pm.response.json(); pm.expect(b.pagination.total).to.eql(1); pm.expect(b.data[0].customer.email).to.eql('customer@example.com'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?q={{orderReference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{orderReference}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "8. Order detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has items, customer and timeline', () => { const b = pm.response.json(); pm.expect(b.items).to.have.lengthOf(1); pm.expect(b.customer.name).to.eql('Test Customer'); pm.expect(b.status_history).to.have.lengthOf(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "9. Invalid transition is rejected (Placed to Completed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('INVALID_TRANSITION error shape', () => { const e = pm.response.json().error; pm.expect(e.code).to.eql('INVALID_TRANSITION'); pm.expect(e).to.have.keys('code','message','details'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/transitions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "transitions"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"Completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10. Cancelling needs a reason",
          "event": [
