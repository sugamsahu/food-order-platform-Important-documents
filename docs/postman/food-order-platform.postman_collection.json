                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"Cancelled\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
